#!/usr/bin/env python3
"""Build/check a ZERO 3E raw SD image, or plan an explicitly confirmed disk write."""

import argparse
import json
import os
from pathlib import Path
import sys

from zero3e_sd import build_image, device_plan, inspect_media, regular_destination, write_confirmed


def main():
    root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    build = sub.add_parser("build", help="create only a regular raw image file; never writes a disk")
    build.add_argument("--sdk-root", type=Path, default=Path(os.environ.get(
        "ZT_SDK_ROOT", "/home/ww/codings/sdks/radxa-rk356x-linux6.1-rkr4")))
    build.add_argument("--output", type=Path, default=root / "build/zero3e-sd/zenith-zero3e-sd.img")
    build.add_argument("--size-mib", type=int, default=7168)
    build.add_argument("--report", type=Path)
    check = sub.add_parser("check", help="check GPT, BootROM IDB integrity, FIT and filesystem positions")
    check.add_argument("image", type=Path)
    check.add_argument("--report", type=Path)
    for command in ("plan", "write"):
        entry = sub.add_parser(command, help="read-only device plan" if command == "plan" else
                               "write a disk only after root + interactive exact-device confirmation")
        entry.add_argument("image", type=Path)
        entry.add_argument("device", type=Path)
        entry.add_argument("--report", type=Path)
    args = parser.parse_args()
    try:
        if args.command == "build":
            report = args.report or args.output.absolute().with_suffix(".json")
            forbidden = list((args.sdk_root / "output/firmware").glob("*"))
            forbidden += [args.output, args.output.with_suffix(".idbloader.img")]
        else:
            report = args.report
            forbidden = [args.image]
            if args.command in ("plan", "write"):
                forbidden.append(args.device)
        if report:
            regular_destination(report, forbidden)
        if args.command == "build":
            output = args.output.absolute()
            result = build_image(args.sdk_root.resolve(), output, args.size_mib)
        elif args.command == "check":
            result = inspect_media(args.image.resolve())
        else:
            action = device_plan if args.command == "plan" else write_confirmed
            result = action(args.image.resolve(), args.device.resolve())
        content = json.dumps(result, indent=2) + "\n"
        if report:
            report.parent.mkdir(parents=True, exist_ok=True)
            report.write_text(content)
        print(content, end="")
        return 0
    except (OSError, ValueError, RuntimeError, EOFError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
