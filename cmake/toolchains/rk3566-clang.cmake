set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(ZT_RK_SDK_ROOT "" CACHE PATH "Buildroot host directory or relocated application SDK root")
if(NOT ZT_RK_SDK_ROOT AND DEFINED ENV{ZT_RK_SDK_ROOT})
    set(ZT_RK_SDK_ROOT "$ENV{ZT_RK_SDK_ROOT}" CACHE PATH "Buildroot host directory or relocated application SDK root" FORCE)
endif()
if(NOT EXISTS "${ZT_RK_SDK_ROOT}/aarch64-buildroot-linux-gnu/sysroot/usr/include/stdio.h")
    message(FATAL_ERROR "ZT_RK_SDK_ROOT must contain a built aarch64-buildroot-linux-gnu/sysroot. See doc/SDK_INTEGRATION.md.")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZT_RK_SDK_ROOT ZT_STAGING_PREFIX)
set(CMAKE_SYSROOT "${ZT_RK_SDK_ROOT}/aarch64-buildroot-linux-gnu/sysroot")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-buildroot-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-buildroot-linux-gnu)
set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN "${ZT_RK_SDK_ROOT}")
set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN "${ZT_RK_SDK_ROOT}")
set(CMAKE_C_FLAGS_INIT "-march=armv8-a -mtune=cortex-a55")
set(CMAKE_CXX_FLAGS_INIT "-march=armv8-a -mtune=cortex-a55")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
find_program(CMAKE_AR NAMES llvm-ar REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib REQUIRED)

set(CMAKE_FIND_ROOT_PATH "${ZT_STAGING_PREFIX}" "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
# Application dependencies use CMake exports. pkg-config is reserved for SDK libraries,
# avoiding double-sysroot prefixing of absolute staging paths.
