+/* Keep composition alive until both CRC capture and all writeback jobs release it.
+ * In particular, deferred cleanup of job N must not turn off job N+1.
+ */
+int vkms_composer_get(struct vkms_output *out)
+{
+	bool already_enabled;
+	int ret;
 
 	spin_lock_irq(&out->lock);
-	old_enabled = out->composer_enabled;
-	out->composer_enabled = enabled;
+	if (out->composer_users) {
