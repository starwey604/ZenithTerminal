+
+/* Exact Q32.32 channel contributions, shared by all NV12 planes. */
+struct vkms_nv12_lut {
+	s64 contribution[3][256][3];
+};
+
+static struct vkms_nv12_lut
+nv12_luts[DRM_COLOR_ENCODING_MAX][DRM_COLOR_RANGE_MAX] __ro_after_init;
+
+static void vkms_build_nv12_lut(struct vkms_nv12_lut *lut,
+			       const struct conversion_matrix *matrix)
+{
+	int channel, value, component;
+
+	for (channel = 0; channel < 3; channel++) {
+		int offset = channel ? 128 : matrix->y_offset;
+
+		for (value = 0; value < 256; value++) {
+			s64 input = drm_int2fixp((value - offset) * 257);
+
+			for (component = 0; component < 3; component++)
+				lut->contribution[channel][value][component] =
+					vkms_fixp_mul(matrix->matrix[component][channel], input);
+		}
+	}
+}
+
+struct vkms_nv12_chroma {
+	s64 r, g, b;
+};
+
+/* All six DRM YUV matrices have equal Y coefficients and zero R/U, B/V. */
+static struct vkms_nv12_chroma
+vkms_nv12_chroma(const struct vkms_nv12_lut *lut, u8 u, u8 v)
+{
+	return (struct vkms_nv12_chroma) {
+		.r = lut->contribution[2][v][0],
+		.g = lut->contribution[1][u][1] + lut->contribution[2][v][1],
+		.b = lut->contribution[1][u][2],
+	};
+}
+
+static struct pixel_argb_u16
+argb_u16_from_nv12_lut(const struct vkms_nv12_lut *lut, u8 y,
+			 struct vkms_nv12_chroma chroma)
+{
+	s64 cy = lut->contribution[0][y][0];
+	s64 r = drm_fixp2int_round(cy + chroma.r);
+	s64 g = drm_fixp2int_round(cy + chroma.g);
+	s64 b = drm_fixp2int_round(cy + chroma.b);
+
+	return argb_u16_from_u16161616(0xffff, clamp(r, 0, 0xffff),
+				     clamp(g, 0, 0xffff), clamp(b, 0, 0xffff));
+}
+
+/* Preserve crop/rotation/chroma siting from the generic NV12 reader. */
+static void NV12_read_line(const struct vkms_plane_state *plane, int x_start,
+			  int y_start, enum pixel_read_direction direction, int count,
+			  struct pixel_argb_u16 out_pixel[])
+{
+	const struct drm_plane_state *state = &plane->base.base;
+	const struct vkms_nv12_lut *lut = &nv12_luts[state->color_encoding][state->color_range];
+	u8 *y, *uv;
+	struct vkms_nv12_chroma chroma;
+	int step_y = get_block_step_bytes(plane->frame_info->fb, direction, 0);
+	int step_uv = get_block_step_bytes(plane->frame_info->fb, direction, 1);
+	int offset = get_subsampling_offset(direction, x_start, y_start);
+	int i;
+
+	if (count <= 0)
+		return;
+
+	packed_pixels_addr_1x1(plane->frame_info, x_start, y_start, 0, &y);
+	packed_pixels_addr_1x1(plane->frame_info, x_start / 2, y_start / 2, 1, &uv);
+	chroma = vkms_nv12_chroma(lut, uv[0], uv[1]);
+	for (i = 0; i < count; i++) {
+		out_pixel[i] = argb_u16_from_nv12_lut(lut, y[0], chroma);
+		y += step_y;
+		if (!((i + offset + 1) & 1) && i + 1 < count) {
+			uv += step_uv;
+			chroma = vkms_nv12_chroma(lut, uv[0], uv[1]);
+		}
+	}
+}
 
