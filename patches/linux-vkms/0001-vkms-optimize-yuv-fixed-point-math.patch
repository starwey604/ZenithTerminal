+/* Same u32 wrap and rounding as the composer's premultiplied equation. */
+static u16 vkms_blend_u8_channel(u8 src, u16 dst, u16 alpha)
+{
+	u32 value = (u32)src * 257 * 0xffff + (u32)dst * (0xffff - alpha);
+
+	return DIV_ROUND_CLOSEST(value, 0xffff);
+}
+
+/* Used only with no color pipeline: combine expansion and blending in one pass. */
+void vkms_argb8888_blend_line(const struct vkms_plane_state *plane, int x_start,
+			     int y_start, enum pixel_read_direction direction, int count,
+			     struct pixel_argb_u16 out[])
+{
+	int step = get_block_step_bytes(plane->frame_info->fb, direction, 0);
+	u8 *src;
+
+	packed_pixels_addr_1x1(plane->frame_info, x_start, y_start, 0, &src);
+	for (int i = 0; i < count; i++) {
+		u16 alpha = src[3] * 257;
+
+		if (alpha == 0xffff) {
+			out[i] = argb_u16_from_u8888(255, src[2], src[1], src[0]);
+		} else if (src[0] | src[1] | src[2] | src[3]) {
+			out[i].a = 0xffff;
+			out[i].r = vkms_blend_u8_channel(src[2], out[i].r, alpha);
+			out[i].g = vkms_blend_u8_channel(src[1], out[i].g, alpha);
+			out[i].b = vkms_blend_u8_channel(src[0], out[i].b, alpha);
+		} else {
+			out[i].a = 0xffff;
+		}
+		if (i + 1 < count)
+			src += step;
+	}
+}
