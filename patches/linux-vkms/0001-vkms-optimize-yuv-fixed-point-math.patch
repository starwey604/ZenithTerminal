+	       vkms_fixp_mul(matrix->matrix[2][1], fp_channel_1) +
+	       vkms_fixp_mul(matrix->matrix[2][2], fp_channel_2);
 
 	fp_r = drm_fixp2int_round(fp_r);
 	fp_g = drm_fixp2int_round(fp_g);
