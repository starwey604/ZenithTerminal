+/* Initialize before configfs can create devices; tables are read-only thereafter. */
+void __init vkms_init_nv12_luts(void)
+{
+	struct conversion_matrix matrix;
+	int encoding, range;
+
+	for (encoding = 0; encoding < DRM_COLOR_ENCODING_MAX; encoding++) {
+		for (range = 0; range < DRM_COLOR_RANGE_MAX; range++) {
+			get_conversion_matrix_to_argb_u16(DRM_FORMAT_NV12, encoding, range,
+							 &matrix);
+			vkms_build_nv12_lut(&nv12_luts[encoding][range], &matrix);
+		}
+	}
+}
