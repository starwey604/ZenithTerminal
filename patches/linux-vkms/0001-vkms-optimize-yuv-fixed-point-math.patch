+/*
+ * Keep drm_fixp_mul's scaling and truncation, but find the highest
+ * non-sign bit with the architecture's bit-scan primitive.  This avoids
+ * two bit-by-bit searches for every YUV matrix multiplication.
+ */
+static unsigned int vkms_fixp_msbset(s64 value)
+{
+	u64 magnitude = value < 0 ? ~(u64)value : (u64)value;
+	int bits = fls64(magnitude);
+
+	return bits ? bits - 1 : 0;
+}
+
+static s64 vkms_fixp_mul(s64 a, s64 b)
+{
+	unsigned int shift = vkms_fixp_msbset(a) + vkms_fixp_msbset(b);
+	s64 result;
+
+	if (shift > 61) {
+		shift -= 61;
+		a >>= (shift >> 1) + (shift & 1);
+		b >>= shift >> 1;
+	} else {
+		shift = 0;
+	}
+
+	result = a * b;
+	if (shift > DRM_FIXED_POINT)
+		return result << (shift - DRM_FIXED_POINT);
+	if (shift < DRM_FIXED_POINT)
+		return result >> (DRM_FIXED_POINT - shift);
+	return result;
+}
