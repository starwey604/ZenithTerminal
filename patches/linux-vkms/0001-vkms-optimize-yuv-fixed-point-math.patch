+/* Direct calls allow inlining without per-pixel indirect-call overhead. */
+static void vkms_xrgb8888_write_line(u8 *dst, const struct pixel_argb_u16 *src, int count)
+{
+	int x;
+
+	for (x = 0; x < count; x++)
+		argb_u16_to_XRGB8888(dst + x * 4, &src[x]);
+}
